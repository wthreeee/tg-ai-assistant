# Ключ Claude API (console.anthropic.com). Без него — демо-режим: поиск ответа по базе знаний
ANTHROPIC_API_KEY=

# Модель Claude. Для экономии: claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# Токен Telegram-бота от @BotFather. Без него работает только чат для сайта
BOT_TOKEN=

# Telegram ID менеджеров через запятую (узнать свой: /myid в боте)
ADMIN_IDS=

BUSINESS_NAME=Speak Up
KNOWLEDGE_DIR=knowledge
PORT=3000

# HTTP-прокси для Telegram API, если api.telegram.org недоступен напрямую
# TELEGRAM_PROXY=http://127.0.0.1:10809
